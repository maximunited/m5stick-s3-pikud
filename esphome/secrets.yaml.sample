# Copy to secrets.yaml (same directory). Never commit secrets.yaml.
# 2.4 GHz Wi-Fi only — ESP32-S3 does not support 5 GHz.

wifi_ssid: "your_2.4ghz_ssid"
wifi_password: "your_wifi_password"

# Generated once; keep stable across re-flashes so HA keeps the same pairing.
# Must be valid base64 (32 bytes). Generate: openssl rand -base64 32
api_encryption_key: "YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE="
ota_password: "generate_with_openssl_rand_hex_16"
ap_password: "fallback_hotspot_password"
